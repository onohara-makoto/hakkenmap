# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project (Dashboard → Project Settings → API). Public by design; access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Gemini API key for /api/identify. Server-only: never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Only for scripts/verify-rls.mjs and scripts/cleanup-orphan-photos.mjs. Not used by the app.
# SUPABASE_SERVICE_ROLE_KEY=
